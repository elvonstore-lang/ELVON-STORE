rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'elvonstore1@gmail.com';
    }
    function signedIn() { return request.auth != null; }
    // حجم معقول باش حتى واحد ما يعمر القاعدة بالزبل
    function smallDoc() { return request.resource.data.size() <= 40; }

    // المنتجات والإعدادات: الكل يقرا، المدير وحده يكتب
    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    // promos: أكواد العملات (CH_<البصمة>) — الزبون كيقرا غير الكود لي عارف، ما يقدرش يشوف اللائحة
    match /promos/{id}   { allow get: if true; allow list: if isAdmin(); allow write: if isAdmin(); }
    // settings: الإعدادات (main)، الرصيد (wal_...) ونسخة الرقم (phone_...) — اللائحة والكتابة غير للمدير
    match /settings/{id} { allow get: if true; allow list: if isAdmin(); allow write: if isAdmin(); }

    // الطلبات: الزبون كيصيفط طلب جديد فقط، والمدير وحده يقرا ويبدل
    match /orders/{id} {
      allow create: if isAdmin() || smallDoc() && (
        // طلب عادي
        (request.resource.data.status == 'جديد' && request.resource.data.total is number && request.resource.data.total >= 0
          && (!('coinsSpentApplied' in request.resource.data) || request.resource.data.coinsSpentApplied == false)
          && (!('coinsEarnedApplied' in request.resource.data) || request.resource.data.coinsEarnedApplied == false))
        // سجل حساب العملات: غير مول الحساب
        || (signedIn() && request.resource.data.type == 'account' && id == 'ACCT_' + request.auth.uid && request.resource.data.uid == request.auth.uid)
      );
      allow read, update, delete: if isAdmin();
    }

    // مواعيد الورشة
    match /appointments/{id} {
      allow create: if smallDoc() && request.resource.data.status == 'جديد';
      allow read, update, delete: if isAdmin();
    }

    // track: تتبع الطلبات، التقييمات (rv_)، أكواد/طلبات العملات (w_<uid>)، استعمالات الأكواد (c_<code>)
    match /track/{key}/orders/{docId} {
      allow get, list: if true;
      allow create: if smallDoc() && request.resource.data.status == 'جديد'
        // حساب العملات: غير مول الحساب كيكتب ف w_ ديالو
        && (!key.matches('w_.*') || (signedIn() && key == 'w_' + request.auth.uid
              && (!('coinsSpentApplied' in request.resource.data) || request.resource.data.coinsSpentApplied == false)
              && (!('coinsEarnedApplied' in request.resource.data) || request.resource.data.coinsEarnedApplied == false)))
        // استعمال الكود: غير بسمية الحساب ديالو
        && (!key.matches('c_.*') || (signedIn() && docId == request.auth.uid))
        // التقييم: نجوم من 1 حتى 5 وكلام قصير
        && (!key.matches('rv_.*') || (request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
              && request.resource.data.comment is string && request.resource.data.comment.size() <= 400
              && request.resource.data.author is string && request.resource.data.author.size() <= 30));
      allow update, delete: if isAdmin();
    }

    // أي حاجة أخرى ممنوعة
    match /{document=**} { allow read, write: if false; }
  }
}
