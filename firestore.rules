rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'elvonstore1@gmail.com';
    }
    // الكل يقرأ المنتجات والكوبونات والإعدادات، المدير فقط يعدل
    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /promos/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }
    // الزبون يقدر يرسل طلب فقط، والمدير وحده يقرأه ويعدله
    match /orders/{id}   { allow create: if true; allow read, update, delete: if isAdmin(); }
    // مواعيد الورشة: الزبون ينشئ موعداً جديداً فقط، والمدير وحده يقرأه ويعدله
    match /appointments/{id} {
      allow create: if request.resource.data.status == 'جديد';
      allow read, update, delete: if isAdmin();
    }
    // أكواد العملات: الزبون يقدر يقرأ غير الكود لي عارف (ما يقدرش يشوف اللائحة)، والمدير وحده يصاوبهم
    match /coincodes/{c} {
      allow get: if true;
      allow list, write: if isAdmin();
    }
    // عملات ELVON: حسابات الزبناء (رقم الهاتف + كلمة السر) — wallets/{uid}
    // الزبون يقرأ غير الحساب ديالو، والمدير وحده يبدل الرصيد
    function isUser(u) {
      return request.auth != null && request.auth.uid == u;
    }
    // phones/{الرقم}: نسخة الحساب (كتبدل ملي الزبون كينسا كلمة السر) — المدير وحده يكتب
    match /phones/{n} {
      allow get: if true;
      allow list, write: if isAdmin();
    }
    match /wallets/{u} {
      allow get: if isUser(u) || isAdmin();
      allow create: if isAdmin() || (isUser(u)
        && request.resource.data.keys().hasOnly(['name', 'phone', 'createdAt'])
        && request.auth.token.email.matches('p' + request.resource.data.phone + 'v[0-9]+@users[.]elvon[.]store'));
      allow update: if isAdmin();
      allow list, delete: if isAdmin();
      // أكواد العملات لي دخل الزبون: مرة وحدة لكل كود، وبنفس العدد لي حط المدير
      match /redeems/{c} {
        allow get, list: if isUser(u) || isAdmin();
        allow create: if isUser(u)
          && exists(/databases/$(database)/documents/coincodes/$(c))
          && get(/databases/$(database)/documents/coincodes/$(c)).data.active == true
          && request.resource.data.coins == get(/databases/$(database)/documents/coincodes/$(c)).data.coins
          && request.resource.data.keys().hasOnly(['coins', 'at']);
        allow update, delete: if isAdmin();
      }
      // نسخة من طلبات الزبون باش يشوف العملات المحجوزة والجاية
      match /orders/{o} {
        allow get, list: if isUser(u) || isAdmin();
        allow create: if isUser(u)
          && request.resource.data.coinsSpentApplied == false
          && request.resource.data.coinsEarnedApplied == false;
        allow update, delete: if isAdmin();
      }
    }
    // تتبع الطلب بالهاتف: الزبون يقدر يقرأ طلباته (بمعرفة رقمه) وينشئ سجلاً جديداً بحالة "جديد" فقط، والمدير وحده يغير الحالة
    match /track/{phoneHash}/orders/{orderId} {
      allow get, list: if true;
      allow create: if request.resource.data.status == 'جديد';
      allow update, delete: if isAdmin();
    }
  }
}
