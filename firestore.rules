rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'ضع-بريدك-هنا@gmail.com';
    }
    // الكل يقرأ المنتجات والكوبونات والإعدادات، المدير فقط يعدل
    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /promos/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }
    // الزبون يقدر يرسل طلب فقط، والمدير وحده يقرأه ويعدله
    match /orders/{id}   { allow create: if true; allow read, update, delete: if isAdmin(); }
    // مواعيد الورشة: الزبون ينشئ موعداً جديداً فقط، والمدير وحده يقرأه ويعدله
    match /appointments/{id} {
      allow create: if request.resource.data.status == 'جديد';
      allow read, update, delete: if isAdmin();
    }
    // تتبع الطلب بالهاتف: الزبون يقدر يقرأ طلباته (بمعرفة رقمه) وينشئ سجلاً جديداً بحالة "جديد" فقط، والمدير وحده يغير الحالة
    match /track/{phoneHash}/orders/{orderId} {
      allow get, list: if true;
      allow create: if request.resource.data.status == 'جديد';
      allow update, delete: if isAdmin();
    }
  }
}
