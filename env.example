# Copy these names into Vercel > Project > Settings > Environment Variables.
# NEVER commit a real .env file. Values below are intentionally empty.

# Free AI (recommended): key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional: enables free-form AI answers through /api/ai (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: restrict /api/ai to your own domain, e.g. https://your-store.vercel.app (leave empty to allow any)
ALLOWED_ORIGIN=
